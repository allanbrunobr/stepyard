# Copy to .env and replace every "change-me" value before running `npm run dev`.
# These are placeholders, not working credentials.

# Database
POSTGRES_USER=stepyard
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=stepyard
POSTGRES_HOST=db
POSTGRES_PORT=5432

# API (Bearer secret for dispatch). Generate one with: openssl rand -hex 32
API_PORT=3001
API_SECRET=change-me-api-secret

# Web
WEB_PORT=5173

# LiteLLM proxy (docker compose service `litellm`)
LITELLM_MASTER_KEY=sk-change-me-litellm-key

# Optional: forwarded to the host when the dashboard dispatches over SSH
# STEPYARD_HOST_DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/DB
# ANTHROPIC_API_KEY=
# GH_TOKEN=
